# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
# host=db refers to the Postgres container service name in docker-compose
# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB below
DB_URL=host=db user=CHANGE_ME password=CHANGE_ME dbname=bridge port=5432 sslmode=disable

# PostgreSQL container config
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bridge

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

# ── Gin ───────────────────────────────────────────────────────────────────────
# debug | release
GIN_MODE=release

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Storage ───────────────────────────────────────────────────────────────────
# Driver options: local | s3 | r2
#
#   local  → files saved to ./storage/ on disk (mounted Docker volume)
#   s3     → AWS S3
#   r2     → Cloudflare R2 (S3-compatible, no egress fees)
#
STORAGE_DRIVER=local

# Required for s3 and r2 drivers:
STORAGE_ACCESS_KEY_ID=CHANGE_ME
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
STORAGE_BUCKET=bridge-media

# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# For AWS S3: leave empty (uses default AWS endpoint)
STORAGE_ENDPOINT=

# For Cloudflare R2: auto
# For AWS S3: us-east-1, eu-west-1, etc.
STORAGE_REGION=auto

# Public base URL for uploaded files (no trailing slash)
# For R2 public bucket: https://pub-xxxx.r2.dev
# For R2 custom domain:  https://media.yourdomain.com
# For S3:                https://bridge-media.s3.us-east-1.amazonaws.com
STORAGE_PUBLIC_URL=https://media.yourdomain.com
