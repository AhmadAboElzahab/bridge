PORT=8080

# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB below
DB_URL=host=db user=CHANGE_ME password=CHANGE_ME dbname=bridge port=5432 sslmode=disable

# PostgreSQL container config
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bridge

JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING

GIN_MODE=release
